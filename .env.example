# Canonical URL for metadata / Open Graph (optional; defaults to cfstats.vercel.app)
NEXT_PUBLIC_SITE_URL="https://cfstats.vercel.app"

GEMINI_API_KEY=""

NEXT_PUBLIC_CLIST_API_KEY=""

# Neon gives two endpoints for the SAME database: a pooled one and a direct one.
# The app reads through DATABASE_URL; `prisma migrate` always uses DIRECT_URL.
#
# They MUST be the same endpoint, differing only by the `-pooler` suffix. If they
# point at different databases, migrations land somewhere the app never reads —
# which is how this project ran for months with a `Feedback` table that existed
# on one database and an app talking to another.
#
#   DATABASE_URL  postgresql://…@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require
#   DIRECT_URL    postgresql://…@ep-xxxx.region.aws.neon.tech/db?sslmode=require
#                                        ^ same endpoint, no -pooler
DATABASE_URL=""
DIRECT_URL=""

